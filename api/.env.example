PORT=4000
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# The relayer VOID uses to self-submit UserOps (see README for why there's no third-party bundler
# yet) and to pay deployment/config gas on the owner's behalf. Defaults to Anvil's well-known
# account #0 — fine for local dev, but the API refuses to start with that key against any
# CHAIN_ID other than 31337. Set a real, funded key for anything else.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
